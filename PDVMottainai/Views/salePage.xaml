<Page x:Class="PDVMottainai.Views.salePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:PDVMottainai.Views"
      mc:Ignorable="d"
      Title="salePage" 
      >
    <Grid 
        Background="White"
        HorizontalAlignment="Stretch" 
        VerticalAlignment="Stretch">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="12*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#377448">
            
        </Grid>
        
       
        <Grid 
            Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border
                Background="#E4F4EA"
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Row="0">
                <TextBlock
                    Text="Nº Venda"
                    FontSize="22"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="./Fonts/#DM Sans"
                    FontWeight="Medium"
                    />
            </Border>
            <Border
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Row="1">
                <TextBlock
                    Text="34"
                    FontSize="22"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="./Fonts/#DM Sans"
                    />
            </Border>

            <Border
                Background="#E4F4EA"
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Row="0"
                Grid.Column="1">
                <TextBlock
                    Text="Data Venda"
                    FontSize="22"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="./Fonts/#DM Sans"
                    FontWeight="Medium"
                    />
            </Border>
            <Border
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Row="1"
                Grid.Column="1">
                <TextBlock
                    Text="09/09/2026 09:35:54"
                    FontSize="22"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="./Fonts/#DM Sans"
                    />
            </Border>
            

            <Border
                Background="#E4F4EA"
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Row="0"
                Grid.Column="2">
                <TextBlock
                    Text="Cliente"
                    FontSize="22"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="./Fonts/#DM Sans"
                    FontWeight="Medium"
                    />
            </Border>
            <Border
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Row="1"
                Grid.Column="2">
                <TextBlock
                    Text="Não Selecionado"
                    FontSize="22"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="./Fonts/#DM Sans"
                    />
            </Border>

            <Border
                Background="#E4F4EA"
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Row="0"
                Grid.Column="3">
                <TextBlock
                    Text="Vendedor"
                    FontSize="22"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="./Fonts/#DM Sans"
                    FontWeight="Medium"
                    />
            </Border>
            <Border
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Row="1"
                Grid.Column="3">
                <TextBlock
                    Text="Guilherme"
                    FontSize="22"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="./Fonts/#DM Sans"
                    />
            </Border>

            <Border
                Background="#E4F4EA"
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Row="0"
                Grid.Column="4">
                <TextBlock
                    Text="Loja"
                    FontSize="22"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="./Fonts/#DM Sans"
                    FontWeight="Medium"
                    />
            </Border>
            <Border
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Row="1"
                Grid.Column="4">
                <TextBlock
                    Text="Unidade Paulista"
                    FontSize="22"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="./Fonts/#DM Sans"
                    />
            </Border>











        </Grid>
        
        <Grid Grid.Row="2" Background="BlanchedAlmond"></Grid>
        <Grid Grid.Row="3" Background="Blue"></Grid>
        <Grid Grid.Row="4" Background="YellowGreen"></Grid>

        <!-- Seus elementos da tela de vendas vão aqui dentro -->
    </Grid>
</Page>