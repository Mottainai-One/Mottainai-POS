<Page x:Class="PDVMottainai.Views.salePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:PDVMottainai.Views"
      mc:Ignorable="d"
      Title="salePage">

    <Page.Resources>
        <!-- Estilo para o Card (Borda com Sombra) -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect 
                        Color="Black" 
                        Direction="315" 
                        ShadowDepth="0" 
                        BlurRadius="5" 
                        Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para os Títulos dentro dos Cards -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>

        <!-- Estilo para os Valores (Textos em Negrito) dentro dos Cards -->
        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid 
            Grid.Row="0" 
            Background="#1B5B36">

            <Image
                Source="/IMG/mottainai.png"
                HorizontalAlignment="Left"
                Margin="20,7,0,7"/>

            <TextBlock x:Name="txtStore"
                Margin="70,0,0,0"
                FontSize="25"
                VerticalAlignment="Center"
                FontFamily="./Fonts/#DM Sans"
                Foreground="White"
                FontWeight="SemiBold"/>

            <TextBlock x:Name="txtDateTime"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                FontSize="25"
                Foreground="White"
                FontWeight="SemiBold"
                Margin="0,0,30,0"/>
        </Grid>

        <!-- INFO CARDS (ROW 1) -->
        <Grid 
            Grid.Row="1" 
            Background="#E8F7ED">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Grid que segura os 5 cards -->
            <Grid 
                Grid.Row="1" 
                Margin="10,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 1: N° Venda -->
                <Border 
                    Grid.Column="0" 
                    Style="{StaticResource CardStyle}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image 
                            Source="/IMG/CartIcon.png" 
                            Margin="15,10,10,10" 
                            VerticalAlignment="Center"/>

                        <StackPanel 
                            Grid.Column="1" 
                            VerticalAlignment="Center">

                            <TextBlock 
                                Text="N° venda" 
                                Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtNumSale" 
                                Style="{StaticResource CardValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 2: CPF do Cliente -->
                <Border 
                    Grid.Column="1" 
                    Style="{StaticResource CardStyle}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image 
                            Source="/IMG/documentIcon.png" 
                            Margin="15,10,10,10" 
                            VerticalAlignment="Center"/>

                        <StackPanel 
                            Grid.Column="1" 
                            VerticalAlignment="Center">

                            <TextBlock 
                                Text="CPF do cliente" 
                                Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtNumSal" 
                                Text="292.357.538-56" 
                                Style="{StaticResource CardValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 3: Nome do Cliente -->
                <Border 
                    Grid.Column="2" 
                    Style="{StaticResource CardStyle}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image 
                            Source="/IMG/userIcon.png" 
                            Margin="15,10,10,10" 
                            VerticalAlignment="Center"/>

                        <StackPanel 
                            Grid.Column="1" 
                            VerticalAlignment="Center">

                            <TextBlock 
                                Text="Nome do cliente" 
                                Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtNumSa" 
                                Text="Rebecca Paulucci" 
                                Style="{StaticResource CardValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 4: Nível do Cliente -->
                <Border 
                    Grid.Column="3" 
                    Style="{StaticResource CardStyle}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image 
                            Source="/IMG/podiumIcon.png" 
                            Margin="15,10,10,10" 
                            VerticalAlignment="Center"/>

                        <StackPanel 
                            Grid.Column="1" 
                            VerticalAlignment="Center">

                            <TextBlock 
                                Text="Nível do cliente" 
                                Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtNumS" 
                                Text="Nível sustentável" 
                                Style="{StaticResource CardValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 5: Status da Venda -->
                <Border 
                    Grid.Column="4" 
                    Style="{StaticResource CardStyle}"
                    Background="#C7F7D7">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image 
                            Source="/IMG/inProgressIcon.png" 
                            Margin="15,12,10,12" 
                            VerticalAlignment="Center"/>

                        <TextBlock x:Name="txtNum" 
                            Grid.Column="1" 
                            Text="Venda em andamento" 
                            TextWrapping="Wrap" 
                            VerticalAlignment="Center" 
                            Style="{StaticResource CardValueStyle}"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- BODY -->
        <Grid 
            Grid.Row="2" 
            Background="#E8F7ED"/>

        <!-- FOOTER -->
        <Grid 
            Grid.Row="3" 
            Background="DarkGoldenrod"/>

    </Grid>
</Page>