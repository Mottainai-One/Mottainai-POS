<Page x:Class="PDVMottainai.Views.salePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:PDVMottainai.Views"
      mc:Ignorable="d"
      Title="salePage" 
      Height="768" Width="1366"
      >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#1B5B36"/>
        <Grid Grid.Row="1" Background="Aquamarine"/>
        <Grid Grid.Row="2" Background="Khaki"/>
        <Grid Grid.Row="3" Background="DarkGoldenrod"/>

    </Grid>
</Page>